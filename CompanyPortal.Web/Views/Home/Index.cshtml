@model EmployeeProfileViewModel

@{
    ViewData["Title"] = "Můj profil";
}

<div class="mb-4">
    <h1 class="fw-bold mb-1">Můj profil</h1>
    <p class="text-muted mb-0">Základní informace o přihlášeném zaměstnanci.</p>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="row align-items-center g-4">
            <div class="col-md-3 text-center">
                <img src="@Model.ImageUrl"
                     alt="@Model.FullName"
                     class="rounded-circle shadow-sm border"
                     style="width: 170px; height: 170px; object-fit: cover;" />

                <h4 class="mt-3 mb-1">@Model.FullName</h4>
                <span class="badge bg-primary">@Model.PositionName</span>
            </div>

            <div class="col-md-9">
                <div class="row g-3">
                    <div class="col-md-6"><div class="p-3 bg-light rounded"><small class="text-muted">@Html.DisplayNameFor(x => x.Id)</small><div class="fw-semibold">@Html.DisplayFor(x => x.Id)</div></div></div>
                    <div class="col-md-6"><div class="p-3 bg-light rounded"><small class="text-muted">@Html.DisplayNameFor(x => x.PersonalNumber)</small><div class="fw-semibold">@Html.DisplayFor(x => x.PersonalNumber)</div></div></div>
                    <div class="col-md-6"><div class="p-3 bg-light rounded"><small class="text-muted">@Html.DisplayNameFor(x => x.FirstName)</small><div class="fw-semibold">@Html.DisplayFor(x => x.FirstName)</div></div></div>
                    <div class="col-md-6"><div class="p-3 bg-light rounded"><small class="text-muted">@Html.DisplayNameFor(x => x.LastName)</small><div class="fw-semibold">@Html.DisplayFor(x => x.LastName)</div></div></div>
                    <div class="col-md-6"><div class="p-3 bg-light rounded"><small class="text-muted">@Html.DisplayNameFor(x => x.ApplicationUserId)</small><div class="fw-semibold">@Html.DisplayFor(x => x.ApplicationUserId)</div></div></div>
                    <div class="col-md-6"><div class="p-3 bg-light rounded"><small class="text-muted">@Html.DisplayNameFor(x => x.PositionName)</small><div class="fw-semibold">@Html.DisplayFor(x => x.PositionName)</div></div></div>
                    <div class="col-md-6"><div class="p-3 bg-light rounded"><small class="text-muted">@Html.DisplayNameFor(x => x.DepartmentName)</small><div class="fw-semibold">@Html.DisplayFor(x => x.DepartmentName)</div></div></div>
                    <div class="col-md-6"><div class="p-3 bg-light rounded"><small class="text-muted">@Html.DisplayNameFor(x => x.SupervisorName)</small><div class="fw-semibold">@Html.DisplayFor(x => x.SupervisorName)</div></div></div>
                    <div class="col-md-6"><div class="p-3 bg-light rounded"><small class="text-muted">@Html.DisplayNameFor(x => x.IsActive)</small><div class="fw-semibold">@Html.DisplayFor(x => x.IsActive)</div></div></div>
                    <div class="col-md-6"><div class="p-3 bg-light rounded"><small class="text-muted">@Html.DisplayNameFor(x => x.CreatedAt)</small><div class="fw-semibold">@Html.DisplayFor(x => x.CreatedAt)</div></div></div>

                    <div class="col-12">
                        <div class="p-3 bg-light rounded">
                            <small class="text-muted">@Html.DisplayNameFor(x => x.Roles)</small>
                            <div class="fw-semibold">@string.Join(", ", Model.Roles)</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="p-3 bg-light rounded info-box">
                            <small class="text-uppercase text-muted fw-bold">
                                @Html.DisplayNameFor(x => x.SubordinateEmployees)
                            </small>

                            <div class="mt-2">
                                @if (Model.SubordinateEmployees.Any())
                                {
                                    <ul class="mb-0">
                                        @foreach (var employee in Model.SubordinateEmployees)
                                        {
                                            <li>
                                                <a asp-area="Administration" asp-controller="Employee" asp-action="Detail" asp-route-id="@employee.Id">
                                                    @($"{employee.FullName} - {employee.PositionName}")
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Zaměstnanec nemá žádné podřízené.
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>