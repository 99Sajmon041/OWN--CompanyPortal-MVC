<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Firemní Portál</title>

    <link rel="stylesheet" href="~/lib/companyportal-theme/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/companyportal-theme/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/companyportal-theme/css/style.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="d-flex" style="min-height: 100vh;">
        <aside class="bg-dark text-white p-3 flex-shrink-0" style="width: 260px; min-height: 100vh;">
            <h4 class="mb-4">
                <i class="bi bi-building"></i> Firemní Portál
            </h4>

            <ul class="nav nav-pills flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house"></i> Můj profil
                    </a>
                </li>

                @if (User.IsInRole(AppRoles.MasterAdmin) || User.IsInRole(AppRoles.HR))
                {
                    <li class="mt-3 text-uppercase text-secondary small">Administrace</li>

                    <li>
                        <a class="nav-link text-white" asp-area="Administration" asp-controller="Employee" asp-action="List">
                            <i class="bi bi-people"></i> Zaměstnanci
                        </a>
                    </li>

                    <li>
                        <a class="nav-link text-white" asp-area="Administration" asp-controller="Department" asp-action="List">
                            <i class="bi bi-diagram-3"></i> Oddělení
                        </a>
                    </li>

                    <li>
                        <a class="nav-link text-white" asp-area="Administration" asp-controller="Position" asp-action="List">
                            <i class="bi bi-person-badge"></i> Pozice
                        </a>
                    </li>
                }

                @if (User.IsInRole(AppRoles.MasterAdmin))
                {
                    <li>
                        <a class="nav-link text-white" asp-area="Administration" asp-controller="Building" asp-action="List">
                            <i class="bi bi-buildings"></i> Budovy
                        </a>
                    </li>

                    <li>
                        <a class="nav-link text-white" asp-area="Administration" asp-controller="ApplicationUser" asp-action="List">
                            <i class="bi bi-person-lock"></i> Aplikační uživatelé
                        </a>
                    </li>

                    <li>
                        <a class="nav-link text-white" asp-area="Administration" asp-controller="Device" asp-action="List">
                            <i class="bi bi-laptop"></i> Zařízení
                        </a>
                    </li>

                    <li>
                        <a class="nav-link text-white" asp-area="Administration" asp-controller="EmployeeDevice" asp-action="List">
                            <i class="bi bi-clock-history"></i> Historie zápůjček
                        </a>
                    </li>
                }
            </ul>
        </aside>

        <div class="flex-grow-1 d-flex flex-column min-vh-100">
            <header class="border-bottom bg-white shadow-sm">
                <div class="container-fluid py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                    <span class="text-muted">
                        <i class="bi bi-person-circle"></i> @User.Identity?.Name
                    </span>
                </div>
            </header>

            <main class="container-fluid p-4 flex-grow-1">
                <div class="mx-auto" style="max-width: 1400px;">
                    <partial name="_Alerts" />

                    @RenderBody()
                </div>
            </main>

            <footer class="border-top text-muted py-3 px-4">
                &copy; @DateTime.UtcNow - Firemní Portál
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/companyportal-theme/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

    <script src="~/lib/companyportal-theme/js/main.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>