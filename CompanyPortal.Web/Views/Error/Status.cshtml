@{
    int statusCode = ViewData["StatusCode"] as int? ?? 500;
    string exceptionMessage = ViewData["ExceptionMessage"] as string ?? string.Empty;

    ViewData["Title"] = $"Chyba {statusCode}";
}

<div class="alert alert-danger">
    Chyba @statusCode
</div>

@if (statusCode == 403)
{
    <p>Nemáte oprávnění pro přístup k této části aplikace - Status kód: @statusCode</p>

}
else if (statusCode == 404)
{
    <p>Požadovaná stránka nebyla nalezena - Status kód: @statusCode</p>

    if (!string.IsNullOrWhiteSpace(exceptionMessage))
    {
        <p>@exceptionMessage</p>
    }
}
else
{
    <p>Při zpracování požadavku nastala chyba - Status kód: @statusCode</p>
}