@model BuildingDetailViewModel

@{
    ViewData["Title"] = "Detail budovy";

    var activeDepartments = Model.Departments
    .Where(x => x.IsActive)
    .OrderBy(x => x.DepartmentName)
    .ToList();

    var inactiveDepartments = Model.Departments
        .Where(x => !x.IsActive)
        .OrderBy(x => x.DepartmentName)
        .ToList();
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fw-bold mb-1">@Model.BuildingName</h1>
        <p class="text-muted mb-0">Detail budovy a přiřazených oddělení.</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="bi bi-pencil-square me-1"></i> Upravit
        </a>

        <a asp-action="List" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Seznam
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-building me-2"></i> Informace o budově
                </h5>
            </div>

            <div class="card-body px-4 pb-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Název</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.BuildingName</dd>

                    <dt class="col-sm-4 text-muted">Kód</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary">@Model.Code</span>
                    </dd>

                    <dt class="col-sm-4 text-muted">Stav</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle me-1"></i> Aktivní
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                <i class="bi bi-x-circle me-1"></i> Neaktivní
                            </span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Popis</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            @Model.Description
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Popis není vyplněn.</span>
                        }
                    </dd>
                </dl>
            </div>

        </div>
    </div>
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-diagram-3 me-2"></i> Oddělení v budově
                </h5>

                <small class="text-muted">
                    Přehled aktivních a neaktivních oddělení přiřazených k této budově.
                </small>
            </div>

            <div class="card-body px-4 pb-4 overflow-auto" style="max-height: 520px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-success mb-0">
                        <i class="bi bi-check-circle me-1"></i> Aktivní oddělení
                    </h6>

                    <span class="badge bg-success">
                        @activeDepartments.Count
                    </span>
                </div>

                @if (activeDepartments.Any())
                {
                    <div class="list-group list-group-flush mb-4">
                        @foreach (var department in activeDepartments)
                        {
                            <a asp-controller="Department" asp-action="Detail" asp-route-id="@department.Id" class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">
                                        @department.DepartmentName
                                    </div>

                                    <small class="text-muted">
                                        @department.BuildingName
                                    </small>
                                </div>

                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center border rounded py-4 mb-4">
                        <i class="bi bi-diagram-3 fs-3 text-muted"></i>
                        <p class="text-muted mt-2 mb-0">
                            K této budově nejsou přiřazena žádná aktivní oddělení.
                        </p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-muted mb-0">
                        <i class="bi bi-x-circle me-1"></i> Neaktivní oddělení
                    </h6>

                    <span class="badge bg-secondary">
                        @inactiveDepartments.Count
                    </span>
                </div>

                @if (inactiveDepartments.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var department in inactiveDepartments)
                        {
                            <a asp-controller="Department" asp-action="Detail" asp-route-id="@department.Id" class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center text-muted">
                                <div>
                                    <div class="fw-semibold">
                                        @department.DepartmentName
                                    </div>

                                    <small>
                                        @department.BuildingName
                                    </small>
                                </div>

                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center border rounded py-4">
                        <i class="bi bi-inbox fs-3 text-muted"></i>
                        <p class="text-muted mt-2 mb-0">
                            K této budově nejsou přiřazena žádná neaktivní oddělení.
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>