@model BuildingUpsertViewModel

@{
    ViewData["Title"] = "Nová budova";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fw-bold mb-1">Nová budova</h1>
        <p class="text-muted mb-0">Vytvoření nové budovy v systému.</p>
    </div>

    <a asp-action="List" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Zpět
    </a>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-building-add me-2"></i> Údaje budovy
                </h5>
            </div>

            <div class="card-body px-4 pb-4">
                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="BuildingName" class="form-label fw-semibold">Název budovy</label>
                        <input asp-for="BuildingName" class="form-control" placeholder="Např. Hala A" />
                        <span asp-validation-for="BuildingName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Code" class="form-label fw-semibold">Kód budovy</label>
                        <input asp-for="Code" class="form-control" placeholder="Např. BUILD-A" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Popis</label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Volitelný krátký popis budovy"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Zrušit
                        </a>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i> Vytvořit
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>