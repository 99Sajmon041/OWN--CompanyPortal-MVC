@model PositionDetailViewModel

@{
    ViewData["Title"] = "Detail pozice";

    var activeEmployees = Model.Employees
        .Where(x => x.IsActive)
        .OrderBy(x => x.FirstName)
        .ThenBy(x => x.LastName)
        .ToList();

    var inactiveEmployees = Model.Employees
        .Where(x => !x.IsActive)
        .OrderBy(x => x.FirstName)
        .ThenBy(x => x.LastName)
        .ToList();
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fw-bold mb-1">@Model.PositionName</h1>
        <p class="text-muted mb-0">Detail pozice a přiřazených zaměstnanců.</p>
    </div>

    <div class="d-flex gap-2">
        @if (Model.PositionLevel == PositionLevel.Administrator)
        {
            <span title="Nelze upravit administrátorskou pozici">
                <span class="btn btn-warning disabled" aria-disabled="true">
                    <i class="bi bi-pencil-square me-1"></i> Upravit
                </span>
            </span>
        }
        else
        {
            <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil-square me-1"></i> Upravit
            </a>
        }

        <a asp-action="List" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Seznam
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-person-badge me-2"></i>Informace o pozici
                </h5>
            </div>

            <div class="card-body px-4 pb-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Název pozice</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.PositionName</dd>

                    <dt class="col-sm-4 text-muted">Úroveň pozice</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.PositionLevel</dd>

                    <dt class="col-sm-4 text-muted">Oddělení</dt>
                    <dd class="col-sm-8 fw-semibold"><a asp-action="Detail" asp-controller="Department" asp-route-id="@Model.DepartmentId">@Model.DepartmentName</a></dd>

                    <dt class="col-sm-4 text-muted">Hodinová sazba</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.HourlyRate.ToString("C2", CultureInfo.GetCultureInfo("cs-CZ"))</dd>

                    <dt class="col-sm-4 text-muted">Stav</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle me-1"></i> Aktivní
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                <i class="bi bi-x-circle me-1"></i> Neaktivní
                            </span>
                        }
                    </dd>
                </dl>
            </div>

        </div>
    </div>
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-person-workspace me-2"></i> Zaměstnanci na pozici
                </h5>

                <small class="text-muted">
                    Aktivní a neaktivní zaměstnanci přiřazení k této pozici.
                </small>
            </div>

            <div class="card-body px-4 pb-4 overflow-auto" style="max-height: 520px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-success mb-0">
                        <i class="bi bi-check-circle me-1"></i> Aktivní zaměstnanci
                    </h6>

                    <span class="badge bg-success">
                        @activeEmployees.Count
                    </span>
                </div>

                @if (activeEmployees.Any())
                {
                    <div class="list-group list-group-flush mb-4">
                        @foreach (var employee in activeEmployees)
                        {
                            <a asp-controller="Employee" asp-action="Detail" asp-route-id="@employee.Id" class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">
                                        @employee.FullName
                                    </div>

                                    <small class="text-primary">
                                        @employee.PersonalNumber
                                    </small>

                                    <div class="small text-muted mt-1">
                                        Vytvořen: @employee.CreatedAt.ToString("dd.MM.yyyy")
                                    </div>
                                </div>

                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center border rounded py-4 mb-4">
                        <i class="bi bi-person-x fs-3 text-muted"></i>
                        <p class="text-muted mt-2 mb-0">
                            Na této pozici nejsou žádní aktivní zaměstnanci.
                        </p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-muted mb-0">
                        <i class="bi bi-x-circle me-1"></i> Neaktivní zaměstnanci
                    </h6>

                    <span class="badge bg-secondary">
                        @inactiveEmployees.Count
                    </span>
                </div>

                @if (inactiveEmployees.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var employee in inactiveEmployees)
                        {
                            <a asp-controller="Employee" asp-action="Detail" asp-route-id="@employee.Id" class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center text-muted">
                                <div>
                                    <div class="fw-semibold">
                                        @employee.FullName
                                    </div>

                                    <small>
                                        @employee.PersonalNumber
                                    </small>

                                    <div class="small mt-1">
                                        Vytvořen: @employee.CreatedAt.ToString("dd.MM.yyyy")
                                    </div>
                                </div>

                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center border rounded py-4">
                        <i class="bi bi-inbox fs-3 text-muted"></i>
                        <p class="text-muted mt-2 mb-0">
                            Na této pozici nejsou žádní neaktivní zaměstnanci.
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>