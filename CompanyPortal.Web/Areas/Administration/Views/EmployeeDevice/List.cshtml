@model PagedResult<EmployeeDeviceViewModel>

@{
    ViewData["Title"] = "Zařízení zaměstnanců";
}

@await Component.InvokeAsync("GridFilters", new GridFiltersComponentModel
{
    ModelType = Model.FilterModelType!,
    Filters = Model.GridRequest.Filters,
    Action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty,
    Controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty,
    PageSize = Model.GridRequest.PageSize,
    SortOrder = Model.GridRequest.SortOrder,
    FiltersCollapsed = Model.GridRequest.FiltersCollapsed
})

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fw-bold mb-1">Zařízení zaměstnanců</h1>
        <p class="text-muted mb-0">Přehled aktuálních a ukončených zápůjček zařízení zaměstnanců.</p>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="scrollable-table-container">

            <div class="scrollable-table-top">
                <div class="scrollable-table-top-inner"></div>
            </div>

            <div class="scrollable-table-wrapper">
                <table class="table table-hover align-middle mb-0 scrollable-table">
                    <thead class="table-light">
                        <tr>
                            <grid-sort property="Id" label="@Html.DisplayNameFor(x => x.Items.First().Id)" />
                            <grid-sort property="EmployeeFullName" label="@Html.DisplayNameFor(x => x.Items.First().EmployeeFullName)" />
                            <grid-sort property="DeviceName" label="@Html.DisplayNameFor(x => x.Items.First().DeviceName)" />
                            <grid-sort property="SerialNumber" label="@Html.DisplayNameFor(x => x.Items.First().SerialNumber)" />
                            <grid-sort property="AssignedAt" label="@Html.DisplayNameFor(x => x.Items.First().AssignedAt)" />
                            <grid-sort property="ReturnedAt" label="@Html.DisplayNameFor(x => x.Items.First().ReturnedAt)" />
                            <grid-sort property="Note" label="@Html.DisplayNameFor(x => x.Items.First().Note)" />
                            <th>Stav</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Items.Any())
                        {
                            @foreach (var employeeDevice in Model.Items)
                            {
                                <tr>
                                    <td class="text-muted">@employeeDevice.Id</td>

                                    <td class="fw-semibold">
                                        <a asp-controller="Employee" asp-action="Detail" asp-route-id="@employeeDevice.EmployeeId">
                                            @employeeDevice.EmployeeFullName
                                        </a>
                                    </td>

                                    <td>
                                        <a asp-controller="Device" asp-action="Detail" asp-route-id="@employeeDevice.DeviceId" class="text-decoration-none">
                                            <i class="bi bi-laptop me-1"></i>
                                            @employeeDevice.DeviceName
                                        </a>
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary font-monospace">
                                            @employeeDevice.SerialNumber
                                        </span>
                                    </td>

                                    <td class="text-nowrap">
                                        @employeeDevice.AssignedAt.ToString("dd.MM.yyyy HH:mm")
                                    </td>

                                    <td class="text-nowrap">
                                        @(employeeDevice.ReturnedAt.HasValue? employeeDevice.ReturnedAt.Value.ToString("dd.MM.yyyy HH:mm") : "-")
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(employeeDevice.Note) ? "-" : employeeDevice.Note)
                                    </td>

                                    <td>
                                        @if (employeeDevice.ReturnedAt.HasValue)
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-check-circle me-1"></i> Vráceno
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-box-arrow-right me-1"></i> Zapůjčeno
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-5">
                                    <i class="bi bi-laptop fs-1 d-block mb-2"></i>
                                    Nebyla nalezena žádná zapůjčená zařízení.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

@await Component.InvokeAsync("Pager", new PagerPartialViewModel
{
    Pager = Model.Pager,
    Action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty,
    Controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty,
    SortOrder = Model.GridRequest.SortOrder,
    PageSize = Model.GridRequest.PageSize,
    Filters = Model.GridRequest.Filters,
    FiltersCollapsed = Model.GridRequest.FiltersCollapsed
})