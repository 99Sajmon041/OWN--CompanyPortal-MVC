@model EmployeePositionUpdateViewModel

@{
    ViewData["Title"] = "Změna pozice zaměstnance";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fw-bold mb-1">Změna pozice zaměstnance</h1>
        <p class="text-muted mb-0">Změna pracovního zařazení vybraného zaměstnance.</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Detail" asp-route-id="@Model.EmployeeId" class="btn btn-outline-primary">
            <i class="bi bi-eye me-1"></i> Detail
        </a>

        <a asp-action="List" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Zpět
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 col-xl-7">
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            Po změně pozice budou uživateli automaticky synchronizovány systémové role.
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-person-workspace me-2"></i> Pracovní zařazení
                </h5>
            </div>

            <div class="card-body px-4 pb-4">
                <form asp-action="PositionUpdate" method="post">

                    <input asp-for="EmployeeId" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Zaměstnanec</label>
                        <div class="form-control bg-light">
                            <i class="bi bi-person me-2 text-muted"></i>
                            @Model.FullName
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Současná pozice</label>
                        <div class="form-control bg-light">
                            <i class="bi bi-person-badge me-2 text-primary"></i>
                            @Model.CurrentPositionName
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PositionId" class="form-label fw-semibold">Nová pozice</label>

                        <select asp-for="PositionId" asp-items="@Model.Positions" class="form-select">
                            <option value="">Vyberte novou pozici</option>
                        </select>

                        <span asp-validation-for="PositionId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Detail" asp-route-id="@Model.EmployeeId" class="btn btn-outline-secondary">
                            Zrušit
                        </a>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-arrow-left-right me-1"></i> Změnit pozici
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>