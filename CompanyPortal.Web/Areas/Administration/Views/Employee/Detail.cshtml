@model EmployeeViewModel

@{
    ViewData["Title"] = "Detail zaměstnance";
    var availableDevices = ViewBag.AvailableDevices as IEnumerable<SelectListItem> ?? [];

    var assignedDevices = Model.EmployeeDevices
    .Where(x => x.ReturnedAt is null)
    .OrderByDescending(x => x.AssignedAt)
    .ToList();

    var returnedDevices = Model.EmployeeDevices
        .Where(x => x.ReturnedAt is not null)
        .OrderByDescending(x => x.ReturnedAt)
        .ToList();
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fw-bold mb-1">@Model.FullName</h1>
        <p class="text-muted mb-0">
            Detail zaměstnance, jeho pracovního zařazení, rolí a zapůjčených zařízení.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="bi bi-pencil-square me-1"></i> Upravit
        </a>

        <a asp-action="List" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Seznam
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-person-vcard me-2"></i>
                    Informace o zaměstnanci
                </h5>
            </div>

            <div class="card-body px-4 pb-4">
                <div class="row g-4">
                    <div class="col-md-auto">
                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.FullName" class="rounded-circle object-fit-cover border" width="110" height="110" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center" style="width: 110px; height: 110px;">
                                <i class="bi bi-person fs-1 text-muted"></i>
                            </div>
                        }
                    </div>

                    <div class="col">
                        <dl class="row mb-0">
                            <dt class="col-sm-5 text-muted">
                                @Html.DisplayNameFor(x => x.PersonalNumber)
                            </dt>
                            <dd class="col-sm-7 fw-semibold">
                                @Html.DisplayFor(x => x.PersonalNumber)
                            </dd>

                            <dt class="col-sm-5 text-muted">
                                @Html.DisplayNameFor(x => x.FirstName)
                            </dt>
                            <dd class="col-sm-7 fw-semibold">
                                @Html.DisplayFor(x => x.FirstName)
                            </dd>

                            <dt class="col-sm-5 text-muted">
                                @Html.DisplayNameFor(x => x.LastName)
                            </dt>
                            <dd class="col-sm-7 fw-semibold">
                                @Html.DisplayFor(x => x.LastName)
                            </dd>

                            <dt class="col-sm-5 text-muted">
                                @Html.DisplayNameFor(x => x.PositionName)
                            </dt>
                            <dd class="col-sm-7">
                                <span class="badge bg-primary">
                                    <i class="bi bi-person-badge me-1"></i>
                                    @Model.PositionName
                                </span>
                            </dd>

                            <dt class="col-sm-5 text-muted">
                                @Html.DisplayNameFor(x => x.SupervisorName)
                            </dt>
                            <dd class="col-sm-7 fw-semibold">
                                <i class="bi bi-person-workspace me-1 text-primary"></i>
                                @(Model.SupervisorName ?? "Zatím není určen")
                            </dd>

                            <dt class="col-sm-5 text-muted">
                                @Html.DisplayNameFor(x => x.CreatedAt)
                            </dt>
                            <dd class="col-sm-7 fw-semibold">
                                @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </dd>

                            <dt class="col-sm-5 text-muted">Stav</dt>
                            <dd class="col-sm-7">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Aktivní
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle me-1"></i>
                                        Neaktivní
                                    </span>
                                }
                            </dd>

                            <dt class="col-sm-5 text-muted">Uživatelský účet</dt>
                            <dd class="col-sm-7">
                                @if (!string.IsNullOrWhiteSpace(Model.ApplicationUserId))
                                {
                                    <span class="text-success fw-semibold">
                                        <i class="bi bi-person-check me-1"></i>
                                        Propojen
                                    </span>
                                }
                                else
                                {
                                    <span class="text-warning fw-semibold">
                                        <i class="bi bi-person-x me-1"></i>
                                        Není propojen
                                    </span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-shield-check me-2"></i>
                    Role zaměstnance
                </h5>

                <span class="badge bg-primary">
                    @Model.Roles.Count
                </span>
            </div>

            <div class="card-body px-4 pb-4">
                @if (Model.Roles.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var role in Model.Roles.OrderBy(x => x))
                        {
                            <span class="badge bg-secondary fs-6">
                                <i class="bi bi-person-lock me-1"></i>
                                @role
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-shield-x fs-1 text-muted"></i>
                        <p class="text-muted mt-3 mb-0">
                            Zaměstnanec nemá přiřazené žádné role.
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0">
                <i class="bi bi-laptop me-2"></i>
                Zařízení zaměstnance
            </h5>

            <small class="text-muted">
                Přehled aktuálně zapůjčených a vrácených zařízení.
            </small>
        </div>

        <span class="badge bg-primary">
            @assignedDevices.Count
        </span>
    </div>

    <div class="card-body px-4 pb-4">
        @if (availableDevices.Any())
        {
            <form asp-controller="EmployeeDevice" asp-action="AssignDevice" method="post" class="mb-4">
                <input type="hidden" name="employeeId" value="@Model.Id" />

                <div class="row g-2 align-items-end">
                    <div class="col-md-8 col-lg-6">
                        <label for="deviceId" class="form-label fw-semibold">Dostupné zařízení</label>

                        <select id="deviceId" name="deviceId" asp-items="availableDevices" class="form-select" required>
                            <option value="">Vyberte zařízení</option>
                        </select>
                    </div>

                    <div class="col-md-8 col-lg-6">
                        <label for="note" class="form-label fw-semibold">Poznámka</label>

                        <input id="note" name="note" placeholder="Zadejte poznámku" class="form-control" />
                    </div>

                    <div class="col-md-auto">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-1"></i> Zapůjčit zařízení
                        </button>
                    </div>
                </div>
            </form>
        }
        else
        {
            <div class="alert alert-light border mb-4">
                <i class="bi bi-info-circle me-1"></i>
                Momentálně není dostupné žádné další zařízení k zapůjčení.
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-success mb-0">
                <i class="bi bi-box-arrow-right me-1"></i>
                Aktuálně zapůjčená zařízení
            </h6>

            <span class="badge bg-success">
                @assignedDevices.Count
            </span>
        </div>

        @if (assignedDevices.Any())
        {
            <div class="table-responsive overflow-auto mb-4" style="max-height: 320px;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>@Html.DisplayNameFor(x => x.EmployeeDevices.First().DeviceName)</th>
                            <th>@Html.DisplayNameFor(x => x.EmployeeDevices.First().SerialNumber)</th>
                            <th>@Html.DisplayNameFor(x => x.EmployeeDevices.First().AssignedAt)</th>
                            <th>@Html.DisplayNameFor(x => x.EmployeeDevices.First().Note)</th>
                            <th class="text-end">Akce</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var employeeDevice in assignedDevices)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    <i class="bi bi-laptop me-2 text-primary"></i>
                                    @employeeDevice.DeviceName
                                </td>

                                <td>
                                    <span class="font-monospace">@employeeDevice.SerialNumber</span>
                                </td>

                                <td class="text-muted">
                                    @employeeDevice.AssignedAt.ToString("dd.MM.yyyy HH:mm")
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(employeeDevice.Note) ? "-" : employeeDevice.Note)
                                </td>

                                <td class="text-end">
                                    <form asp-controller="EmployeeDevice" asp-action="ReturnDevice" method="post" class="d-inline delete-form">
                                        <input type="hidden" name="employeeDeviceId" value="@employeeDevice.Id" />
                                        <input type="hidden" name="employeeId" value="@Model.Id" />

                                        <button type="submit" class="btn btn-sm btn-outline-warning" title="Vrátit zařízení" data-confirm-message="Opravdu chcete označit zařízení jako vrácené?">
                                            <i class="bi bi-box-arrow-in-left"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center border rounded py-4 mb-4">
                <i class="bi bi-laptop fs-2 text-muted"></i>
                <p class="text-muted mt-2 mb-0">
                    Zaměstnanec nemá aktuálně zapůjčené žádné zařízení.
                </p>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-muted mb-0">
                <i class="bi bi-clock-history me-1"></i>
                Vrácená zařízení
            </h6>

            <span class="badge bg-secondary">
                @returnedDevices.Count
            </span>
        </div>

        @if (returnedDevices.Any())
        {
            <div class="table-responsive overflow-auto" style="max-height: 260px;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>@Html.DisplayNameFor(x => x.EmployeeDevices.First().DeviceName)</th>
                            <th>@Html.DisplayNameFor(x => x.EmployeeDevices.First().SerialNumber)</th>
                            <th>@Html.DisplayNameFor(x => x.EmployeeDevices.First().AssignedAt)</th>
                            <th>@Html.DisplayNameFor(x => x.EmployeeDevices.First().ReturnedAt)</th>
                            <th>@Html.DisplayNameFor(x => x.EmployeeDevices.First().Note)</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var employeeDevice in returnedDevices)
                        {
                            <tr class="text-muted">
                                <td class="fw-semibold">
                                    <i class="bi bi-laptop me-2"></i>
                                    @employeeDevice.DeviceName
                                </td>

                                <td>
                                    <span class="font-monospace">@employeeDevice.SerialNumber</span>
                                </td>

                                <td>
                                    @employeeDevice.AssignedAt.ToString("dd.MM.yyyy HH:mm")
                                </td>

                                <td>
                                    @employeeDevice.ReturnedAt?.ToString("dd.MM.yyyy HH:mm")
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(employeeDevice.Note) ? "-" : employeeDevice.Note)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center border rounded py-4">
                <i class="bi bi-inbox fs-2 text-muted"></i>
                <p class="text-muted mt-2 mb-0">
                    Zaměstnanec zatím nemá žádná vrácená zařízení.
                </p>
            </div>
        }
    </div>
</div>