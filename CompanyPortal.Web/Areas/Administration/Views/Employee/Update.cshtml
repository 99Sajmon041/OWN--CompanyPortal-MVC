@model EmployeeUpdateViewModel

@{
    ViewData["Title"] = "Úprava zaměstnance";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fw-bold mb-1">Úprava zaměstnance</h1>
        <p class="text-muted mb-0">Úprava osobních údajů zaměstnance.</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-eye me-1"></i> Detail
        </a>

        <a asp-action="List" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Zpět
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-pencil-square me-2"></i> Údaje zaměstnance
                </h5>
            </div>

            <div class="card-body px-4 pb-4">
                <form asp-action="Update" method="post" enctype="multipart/form-data">

                    <input asp-for="Id" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Aktuální fotografie</label>

                            <div>
                                <img src="@Model.ImageUrl" alt="Fotografie zaměstnance" class="rounded-circle border shadow-sm object-fit-cover" width="120" height="120" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Aktuální fotografie</label>

                            <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center" style="width: 120px; height: 120px;">
                                <i class="bi bi-person fs-1 text-muted"></i>
                            </div>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label fw-semibold"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label fw-semibold"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ImageFile" class="form-label fw-semibold"></label>
                        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                        <div class="form-text">Pokud nevyberete novou fotografii, zůstane zachována stávající.</div>
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                            Zrušit
                        </a>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Uložit změny
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>