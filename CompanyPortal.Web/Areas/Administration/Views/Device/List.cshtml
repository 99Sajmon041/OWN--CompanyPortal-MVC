@model PagedResult<DeviceListItemViewModel>

@{
    ViewData["Title"] = "Seznam zařízení";
}

@await Component.InvokeAsync("GridFilters", new GridFiltersComponentModel
{
    ModelType = Model.FilterModelType!,
    Filters = Model.GridRequest.Filters,
    Action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty,
    Controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty,
    PageSize = Model.GridRequest.PageSize,
    SortOrder = Model.GridRequest.SortOrder,
    FiltersCollapsed = Model.GridRequest.FiltersCollapsed
})

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fw-bold mb-1">Zařízení</h1>
        <p class="text-muted mb-0">Správa firemních zařízení.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Nové zařízení
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="scrollable-table-container">

            <div class="scrollable-table-top">
                <div class="scrollable-table-top-inner"></div>
            </div>

            <div class="scrollable-table-wrapper">
                <table class="table table-hover align-middle mb-0 scrollable-table">
                    <thead class="table-light">
                        <tr>
                            <grid-sort property="Id" label="@Html.DisplayNameFor(x => x.Items.First().Id)" />
                            <grid-sort property="SerialNumber" label="@Html.DisplayNameFor(x => x.Items.First().SerialNumber)" />
                            <grid-sort property="DeviceName" label="@Html.DisplayNameFor(x => x.Items.First().DeviceName)" />
                            <grid-sort property="DeviceType" label="@Html.DisplayNameFor(x => x.Items.First().DeviceType)" />
                            <grid-sort property="PurchasedAt" label="@Html.DisplayNameFor(x => x.Items.First().PurchasedAt)" />
                            <grid-sort property="IsDeprecated" label="@Html.DisplayNameFor(x => x.Items.First().IsDeprecated)" />
                            <th>Poznámka</th>
                            <th class="text-end">Akce</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Items.Any())
                        {
                            @foreach (var device in Model.Items)
                            {
                                <tr>
                                    <td class="text-muted">@device.Id</td>

                                    <td>
                                        <span class="font-monospace fw-semibold">@device.SerialNumber</span>
                                    </td>

                                    <td class="fw-semibold">@device.DeviceName</td>

                                    <td>
                                        <span class="badge bg-secondary">@device.DeviceType</span>
                                    </td>

                                    <td>@device.PurchasedAt.ToString("dd.MM.yyyy")</td>

                                    <td>
                                        @if (device.IsDeprecated)
                                        {
                                            <span class="badge bg-danger">Vyřazené</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Aktivní</span>
                                        }
                                    </td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(device.Note))
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            <span title="@device.Note">
                                                @(device.Note.Length > 50 ? $"{device.Note[..50]}..." : device.Note)
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <a asp-action="Detail" asp-route-id="@device.Id" class="btn btn-sm btn-outline-primary" title="Detail zařízení">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (!device.IsDeprecated)
                                        {
                                            <a asp-action="Update" asp-route-id="@device.Id" class="btn btn-sm btn-outline-secondary" title="Upravit zařízení">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Vyřazené zařízení nelze upravit" disabled>
                                                <i class="bi bi-lock-fill"></i>
                                            </button>
                                        }

                                        <form asp-action="Deprecate" asp-route-id="@device.Id" method="post" class="d-inline delete-form">
                                            @if (!device.IsDeprecated)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Vyřadit zařízení" data-confirm-message="Opravdu chcete zařízení vyřadit? Tato operace je nevratná.">
                                                    <i class="bi bi-toggle-on"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" title="Zařízení je trvale vyřazeno" disabled>
                                                    <i class="bi bi-archive-fill"></i>
                                                </button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    Nebyla nalezena žádná zařízení.
                                </td>
                            </tr>
                        }
                        </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@await Component.InvokeAsync("Pager", new PagerPartialViewModel
{
    Pager = Model.Pager,
    Action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty,
    Controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty,
    SortOrder = Model.GridRequest.SortOrder,
    PageSize = Model.GridRequest.PageSize,
    Filters = Model.GridRequest.Filters,
    FiltersCollapsed = Model.GridRequest.FiltersCollapsed
})