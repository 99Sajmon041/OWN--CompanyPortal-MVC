@model DeviceDetailViewModel

@{
    ViewData["Title"] = "Detail zařízení";

    var activeLoan = Model.EmployeeDevices
        .FirstOrDefault(x => x.ReturnedAt is null);

    var history = Model.EmployeeDevices
        .Where(x => x.ReturnedAt is not null)
        .OrderByDescending(x => x.ReturnedAt)
        .ToList();
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fw-bold mb-1">@Model.DeviceName</h1>
        <p class="text-muted mb-0">Detail zařízení a historie jeho zápůjček.</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="bi bi-pencil-square me-1"></i> Upravit
        </a>

        <a asp-action="List" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Seznam
        </a>
    </div>
</div>

<div class="row g-4">

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-laptop me-2"></i> Informace o zařízení
                </h5>
            </div>

            <div class="card-body px-4 pb-4">
                <dl class="row mb-0">

                    <dt class="col-sm-4 text-muted">Sériové číslo</dt>
                    <dd class="col-sm-8 fw-semibold font-monospace">
                        @Model.SerialNumber
                    </dd>

                    <dt class="col-sm-4 text-muted">Název</dt>
                    <dd class="col-sm-8 fw-semibold">
                        @Model.DeviceName
                    </dd>

                    <dt class="col-sm-4 text-muted">Typ</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary">
                            @Model.DeviceType
                        </span>
                    </dd>

                    <dt class="col-sm-4 text-muted">Pořízeno</dt>
                    <dd class="col-sm-8">
                        @Model.PurchasedAt.ToString("dd.MM.yyyy")
                    </dd>

                    <dt class="col-sm-4 text-muted">Stav</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsDeprecated)
                        {
                            <span class="badge bg-danger">
                                <i class="bi bi-x-circle me-1"></i> Vyřazené
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle me-1"></i> Aktivní
                            </span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Poznámka</dt>
                    <dd class="col-sm-8">
                        @if (string.IsNullOrWhiteSpace(Model.Note))
                        {
                            <span class="text-muted">Bez poznámky</span>
                        }
                        else
                        {
                            @Model.Note
                        }
                    </dd>

                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-clock-history me-2"></i> Historie zápůjček
                </h5>

                <small class="text-muted">
                    Přehled aktuálních i ukončených zápůjček tohoto zařízení.
                </small>
            </div>

            <div class="card-body px-4 pb-4 overflow-auto" style="max-height:520px;">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-success mb-0">
                        <i class="bi bi-box-arrow-right me-1"></i> Aktuální zápůjčka
                    </h6>
                </div>

                @if (activeLoan is not null)
                {
                    <a asp-controller="Employee"
                       asp-action="Detail"
                       asp-route-id="@activeLoan.EmployeeId"
                       class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center mb-4">

                        <div>
                            <div class="fw-semibold">
                                @activeLoan.EmployeeFullName
                            </div>

                            <small class="text-primary">
                                Zapůjčeno @activeLoan.AssignedAt.ToString("dd.MM.yyyy")
                            </small>
                        </div>

                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                }
                else
                {
                    <div class="text-center border rounded py-4 mb-4">
                        <i class="bi bi-laptop fs-3 text-muted"></i>

                        <p class="text-muted mt-2 mb-0">
                            Zařízení není aktuálně nikomu zapůjčeno.
                        </p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-muted mb-0">
                        <i class="bi bi-archive me-1"></i> Historie
                    </h6>

                    <span class="badge bg-secondary">
                        @history.Count
                    </span>
                </div>

                @if (history.Any())
                {
                    <div class="list-group list-group-flush">

                        @foreach (var loan in history)
                        {
                            <a asp-controller="Employee"
                               asp-action="Detail"
                               asp-route-id="@loan.EmployeeId"
                               class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center text-muted">

                                <div>
                                    <div class="fw-semibold">
                                        @loan.EmployeeFullName
                                    </div>

                                    <small>
                                        @loan.AssignedAt.ToString("dd.MM.yyyy")
                                        -
                                        @loan.ReturnedAt?.ToString("dd.MM.yyyy")
                                    </small>
                                </div>

                                <i class="bi bi-chevron-right"></i>
                            </a>
                        }

                    </div>
                }
                else
                {
                    <div class="text-center border rounded py-4">
                        <i class="bi bi-inbox fs-3 text-muted"></i>

                        <p class="text-muted mt-2 mb-0">
                            Zařízení zatím nemá žádnou historii zápůjček.
                        </p>
                    </div>
                }

            </div>
        </div>
    </div>
</div>