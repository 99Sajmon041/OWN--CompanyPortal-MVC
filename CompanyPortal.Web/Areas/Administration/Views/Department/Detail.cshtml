@model DepartmentDetailViewModel

@{
    ViewData["Title"] = "Detail oddělení";
    
    var activePositions = Model.Positions
    .Where(x => x.IsActive)
    .OrderBy(x => x.PositionLevel)
    .ThenBy(x => x.PositionName)
    .ToList();

    var inactivePositions = Model.Positions
        .Where(x => !x.IsActive)
        .OrderBy(x => x.PositionLevel)
        .ThenBy(x => x.PositionName)
        .ToList();
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fw-bold mb-1">@Model.DepartmentName</h1>
        <p class="text-muted mb-0">Detail oddělení a přiřazených pozic.</p>
    </div>

    <div class="d-flex gap-2">
        @if (Model.DepartmentName == SystemDepartment.ALL.ToString())
        {
            <span title="Nelze upravit oddělení ALL">
                <span class="btn btn-warning disabled" aria-disabled="true">
                    <i class="bi bi-pencil-square me-1"></i> Upravit
                </span>
            </span>
        }
        else
        {
            <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil-square me-1"></i> Upravit
            </a>
        }

        <a asp-action="List" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Seznam
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-diagram-3 me-2"></i> Informace o oddělení
                </h5>
            </div>

            <div class="card-body px-4 pb-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Název</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.DepartmentName</dd>

                    <dt class="col-sm-4 text-muted">Budova</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.BuildingName</dd>

                    <dt class="col-sm-4 text-muted">Stav</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle me-1"></i> Aktivní
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                <i class="bi bi-x-circle me-1"></i> Neaktivní
                            </span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Vedoucí</dt>
                    <dd class="col-sm-8">
                        @if (Model.SupervisorId > 0)
                        {
                            <a asp-area="Administration" asp-controller="Employee" asp-action="Detail" asp-route-id="@Model.SupervisorId" class="text-primary text-decoration-none">
                                <i class="bi bi-person-badge me-1"></i>
                                @Model.SupervisorName
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">
                                <i class="bi bi-person-x me-1"></i>
                                Vedoucí není přiřazen
                            </span>
                        }
                    </dd>
                </dl>
            </div>

        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-person-workspace me-2"></i> Pozice v oddělení
                </h5>

                <small class="text-muted">
                    Přehled aktivních a neaktivních pozic přiřazených k tomuto oddělení.
                </small>
            </div>

            <div class="card-body px-4 pb-4 overflow-auto" style="max-height: 520px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-success mb-0">
                        <i class="bi bi-check-circle me-1"></i> Aktivní pozice
                    </h6>

                    <span class="badge bg-success">
                        @activePositions.Count
                    </span>
                </div>

                @if (activePositions.Any())
                {
                    <div class="list-group list-group-flush mb-4">
                        @foreach (var position in activePositions)
                        {
                            <a asp-controller="Position" asp-action="Detail" asp-route-id="@position.Id" class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">
                                        @position.PositionName
                                    </div>

                                    <small class="text-primary">
                                        @position.PositionLevel
                                    </small>
                                </div>

                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center border rounded py-4 mb-4">
                        <i class="bi bi-person-workspace fs-3 text-muted"></i>
                        <p class="text-muted mt-2 mb-0">
                            K tomuto oddělení nejsou přiřazené žádné aktivní pozice.
                        </p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-muted mb-0">
                        <i class="bi bi-x-circle me-1"></i> Neaktivní pozice
                    </h6>

                    <span class="badge bg-secondary">
                        @inactivePositions.Count
                    </span>
                </div>

                @if (inactivePositions.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var position in inactivePositions)
                        {
                            <a asp-controller="Position" asp-action="Detail" asp-route-id="@position.Id" class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center text-muted">
                                <div>
                                    <div class="fw-semibold">
                                        @position.PositionName
                                    </div>

                                    <small>
                                        @position.PositionLevel
                                    </small>
                                </div>

                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center border rounded py-4">
                        <i class="bi bi-inbox fs-3 text-muted"></i>
                        <p class="text-muted mt-2 mb-0">
                            K tomuto oddělení nejsou přiřazené žádné neaktivní pozice.
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>