@model DepartmentUpsertViewModel

@{
    ViewData["Title"] = "Úprava oddělení";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fw-bold mb-1">Úprava oddělení</h1>
        <p class="text-muted mb-0">Úprava údajů vybraného oddělení.</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-eye me-1"></i> Detail
        </a>

        <a asp-action="List" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Zpět
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-pencil-square me-2"></i> Údaje oddělení
                </h5>
            </div>

            <div class="card-body px-4 pb-4">
                <form asp-action="Update" method="post">

                    <input asp-for="Id" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="DepartmentName" class="form-label fw-semibold">Název oddělení</label>
                        <input asp-for="DepartmentName" class="form-control" />
                        <span asp-validation-for="DepartmentName" class="text-danger small"></span>
                    </div>


                    <div class="mb-4">
                        <label asp-for="BuildingId" class="form-label fw-semibold">Budova</label>
                        <select asp-for="BuildingId" asp-items="@Model.Buildings" class="form-select">
                        </select>
                        <span asp-validation-for="BuildingId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                            Zrušit
                        </a>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Uložit změny
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>