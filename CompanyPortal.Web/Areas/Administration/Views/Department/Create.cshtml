@model DepartmentUpsertViewModel

@{
    ViewData["Title"] = "Nové oddělení";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fw-bold mb-1">Nové oddělení</h1>
        <p class="text-muted mb-0">Vytvoření nového oddělení v systému.</p>
    </div>

    <a asp-action="List" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Zpět
    </a>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-building-add me-2"></i> Údaje oddělení
                </h5>
            </div>

            <div class="card-body px-4 pb-4">
                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="DepartmentName" class="form-label fw-semibold">Název oddělení</label>
                        <input asp-for="DepartmentName" class="form-control" placeholder="Např. IT oddělení" />
                        <span asp-validation-for="DepartmentName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BuildingId" class="form-label fw-semibold">Budova</label>
                        <select asp-for="BuildingId" asp-items="@Model.Buildings" class="form-control">
                            <option value="">Vyberte budovu</option>
                        </select>
                        <span asp-validation-for="BuildingId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="List" class="btn btn-outline-secondary">
                            Zrušit
                        </a>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i> Vytvořit
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>